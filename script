#menções a países: contagem de termos na base geral
library(stringr)

paises <- countrycode::codelist$country.name.en

contagem_paises <- data.frame(
  pais = paises,
  n_mencoes = sapply(paises, function(p) {
    sum(str_count(leader_short$caption, regex(paste0("\\b", p, "\\b"), ignore_case = TRUE)), na.rm = TRUE)
  })
)

contagem_paises %>% filter(n_mencoes > 0) %>% arrange(desc(n_mencoes))

